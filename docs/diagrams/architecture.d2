# Parley system architecture
# Render:  npm run diagrams

direction: right

style.fill: "#0b0b12"

vars: {
  d2-config: {
    theme-id: 200
    pad: 60
    layout-engine: elk
  }
}

a: "Browser A" {
  shape: rectangle
  style: {
    fill: "#161228"
    stroke: "#8b7cf6"
    stroke-width: 2
    font-color: "#f2f0ff"
    font-size: 22
    border-radius: 14
    shadow: true
  }
}

sig: "Cloudflare Worker\n\nDurable Object per room\nRelays SDP + ICE\nNever sees media" {
  style: {
    fill: "#10161f"
    stroke: "#64748b"
    stroke-width: 2
    stroke-dash: 4
    font-color: "#cbd5e1"
    font-size: 16
    border-radius: 14
  }
}

b: "Browser B" {
  shape: rectangle
  style: {
    fill: "#161228"
    stroke: "#8b7cf6"
    stroke-width: 2
    font-color: "#f2f0ff"
    font-size: 22
    border-radius: 14
    shadow: true
  }
}

a -> sig: "offer / answer / ICE" {
  style: { stroke: "#a78bfa"; stroke-width: 2; stroke-dash: 4; font-color: "#a78bfa"; font-size: 14 }
}
sig -> b: "offer / answer / ICE" {
  style: { stroke: "#a78bfa"; stroke-width: 2; stroke-dash: 4; font-color: "#a78bfa"; font-size: 14 }
}

a <-> b: "WebRTC  ·  audio + video + data\nDTLS-SRTP encrypted, peer-to-peer" {
  style: { stroke: "#22d3ee"; stroke-width: 5; font-color: "#22d3ee"; font-size: 16 }
}
