{
  "name": "parley",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,party -c magenta,cyan \"npm:dev:web\" \"npm:dev:party\"",
    "build": "next build --turbopack",
    "start": "next start -p 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "shot": "node scripts/shot.mjs",
    "dev:web": "next dev --turbopack -p 3100",
    "dev:party": "wrangler dev --port 1999",
    "deploy:party": "wrangler deploy",
    "test:signaling": "node scripts/test-signaling.mjs",
    "test:call": "node scripts/test-call.mjs",
    "test:mesh": "node scripts/test-mesh.mjs",
    "test:share": "node scripts/test-screenshare.mjs",
    "test:all": "npm run test:signaling && npm run test:call && npm run test:mesh && npm run test:share && npm run test:a11y",
    "test:a11y": "node scripts/test-a11y.mjs",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.46.0",
    "motion": "^13.3.0",
    "next": "15.5.25",
    "next-themes": "^0.4.6",
    "partysocket": "^1.3.0",
    "radix-ui": "^1.6.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "puppeteer-core": "^25.11.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.132.0"
  }
}
