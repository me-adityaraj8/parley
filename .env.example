# Signaling server host (Cloudflare Worker).
# Local dev:  127.0.0.1:1999          (npm run dev:party → wrangler dev)
# Production: parley-signaling.<your-subdomain>.workers.dev
NEXT_PUBLIC_PARTYKIT_HOST=127.0.0.1:1999

# Optional TURN relay. Without it, calls fail for peers behind symmetric
# NAT or restrictive corporate firewalls (see README → Known limitations).
# NEXT_PUBLIC_TURN_URL=turn:your-turn-host:3478
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=
